{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://hushmark.vercel.app",
          "https://hushmark-misty-step.vercel.app",
          "http://localhost:3000"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["content-type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
