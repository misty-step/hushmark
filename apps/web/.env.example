# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET=hushmark

# Worker
# MODAL_WORKER_URL=https://your-modal-app--hushmark-worker-audioseparator-separate.modal.run
# WORKER_CALLBACK_SECRET=your-random-secret
